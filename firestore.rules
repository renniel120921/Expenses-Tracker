rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function validMoney(value) { return value is number && value > 0 && value <= 1000000000000; }
    function shortText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function optionalText(value, max) { return value == null || (value is string && value.size() <= max); }
    function validDateKey(value) { return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    match /users/{uid} {
      allow read, create, update, delete: if owns(uid);

      match /expenses/{entryId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && request.resource.data.type in ['income', 'expense']
          && shortText(request.resource.data.desc, 120)
          && validMoney(request.resource.data.amount)
          && shortText(request.resource.data.category, 50)
          && shortText(request.resource.data.method, 50)
          && (!request.resource.data.keys().hasAny(['spendType']) || request.resource.data.spendType in ['need', 'luho']);
      }

      match /bills/{billId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && shortText(request.resource.data.title, 120)
          && validMoney(request.resource.data.amount)
          && validDateKey(request.resource.data.dueDate)
          && shortText(request.resource.data.category, 50)
          && optionalText(request.resource.data.notes, 500)
          && request.resource.data.status in ['Unpaid', 'Paid'];
      }

      match /utang/{utangId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && shortText(request.resource.data.name, 120)
          && validMoney(request.resource.data.amount)
          && request.resource.data.direction in ['owed_to_me', 'i_owe']
          && (request.resource.data.dueDate == null || validDateKey(request.resource.data.dueDate))
          && optionalText(request.resource.data.notes, 500)
          && request.resource.data.status in ['Unpaid', 'Paid'];
      }

      match /{unknownCollection}/{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
